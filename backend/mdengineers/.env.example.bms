/**
 * BMS Integration Configuration
 * Add these variables to your .env file
 */

# BMS API Configuration
BMS_API_URL=http://localhost:3001
BMS_API_KEY=your_bms_api_key_here

# Database Configuration (if using PostgreSQL for bills)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_NAME=mdengineers

# Optional: Retry Configuration for BMS Integration
BMS_MAX_RETRIES=3
BMS_RETRY_DELAY=1000  # milliseconds

# Optional: Queue Configuration for async bill syncing
BULL_REDIS_URL=redis://localhost:6379

# Optional: Webhook Configuration
BMS_WEBHOOK_URL=http://localhost:8000/api/bills/webhook
BMS_WEBHOOK_SECRET=your_webhook_secret
